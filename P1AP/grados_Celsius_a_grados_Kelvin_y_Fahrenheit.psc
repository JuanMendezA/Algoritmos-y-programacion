// Realizar un algoritmo en pseudoco?digo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo grados_Celsius_a_grados_Kelvin_y_Fahrenheit
	Definir celsius, fahrenheit, kelvin Como Real
	Escribir 'Ingrese Ingrese temperatura en grados Celsius: '
	Leer celsius
	kelvin <- celsius+273.15
	fahrenheit <- (celsius*9/5)+32
	Escribir celsius, '°Celsius equivalen a:'
	Escribir kelvin, ' Kelvin'
	Escribir fahrenheit, ' °Fahrenheit'
FinAlgoritmo
